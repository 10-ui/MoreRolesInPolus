<Project>
	<!-- 
		開発者ごとの設定をカスタマイズする場合：
		1. Directory.Build.props.user.template をコピー
		2. Directory.Build.props.user にリネーム
		3. 自分の環境に合わせてパスを修正
	-->
	
	<PropertyGroup>
		<!-- デフォルトのAmong Usパス -->
		<AmongUs Condition="'$(AmongUs)' == ''">D:\Steam\steamapps\common\Among Us NoS_dev</AmongUs>
	</PropertyGroup>
	
	<!-- ユーザー固有の設定を読み込み（存在する場合） -->
	<Import Project="Directory.Build.props.user" Condition="Exists('Directory.Build.props.user')" />
	
</Project>
